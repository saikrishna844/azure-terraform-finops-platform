subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

location = "centralindia"

environment = "dev"

project_name = "terraform-finops"

owner = "your-name"

cost_center = "CC-1001"

vnet_address_space = [
  "10.10.0.0/16"
]

app_subnet_prefixes = [
  "10.10.1.0/24"
]

management_subnet_prefixes = [
  "10.10.2.0/24"
]

vm_size = "Standard_B1s"

admin_username = "azureadmin"

ssh_public_key_path = "~/.ssh/finops_vm.pub"

cpu_alert_threshold = 80

required_tags = [
  "Environment",
  "Project",
  "Owner",
  "CostCenter",
  "ManagedBy"
]

enforce_tag_policy = false